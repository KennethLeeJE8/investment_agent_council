# Research Council environment template. No provider is selected.
# Copy to .env and fill only the services you intend to use.
# Never commit populated credentials. All values are intentionally blank.

# Model selection and optional endpoint override
COUNCIL_MODEL_PROVIDER=
COUNCIL_MODEL_NAME=
COUNCIL_MODEL_BASE_URL=

# Model provider credentials; configure only the chosen provider(s)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# TiDB Starter: application records and planned workflow checkpoints
TIDB_HOST=
TIDB_PORT=
TIDB_DATABASE=
TIDB_USER=
TIDB_PASSWORD=
TIDB_SSL_CA=

# TiDB Cloud Filesystem: the managed Drive9 service
# Use the regional Filesystem endpoint with its matching file system token.
TIDB_FILESYSTEM_URL=
TIDB_FILESYSTEM_ID=
TIDB_FILESYSTEM_TOKEN=

# mem9: separate expert spaces and one shared publication space
MEM9_API_URL=
MEM9_TECHNOLOGY_EVOLUTION_API_KEY=
MEM9_SEXUAL_SELECTION_API_KEY=
MEM9_NATURAL_SELECTION_API_KEY=
MEM9_CULTURAL_EVOLUTION_API_KEY=
MEM9_ANGEL_INVESTMENT_API_KEY=
MEM9_VENTURE_CAPITAL_API_KEY=
MEM9_SHARED_API_KEY=

# Optional research/search service; independent of model selection
RESEARCH_SEARCH_PROVIDER=
RESEARCH_SEARCH_API_KEY=
RESEARCH_SEARCH_BASE_URL=

# Optional OpenTelemetry export; leave blank for local structured logs only
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
